# ThroughMark clean-room config (read by ci/check_provenance.sh; honored by the guardrail/tag skill).
DDR_DIR=docs/ddr              # one file per Design Decision Record (merge-safe under concurrency)
DDR_LOG=docs/DDR.md           # legacy single-file log; still read if present (pre-migration repos)
TRACE_SOURCE=ticket           # ticket | branch | none — seed the Trace id from the work-item key (unique)
SESSION_SUMMARY=off           # on | off — end-of-session summary
# --- Vendor enablement (public product docs & official repos) ---
ENABLEMENT=on                 # on | off — allow the guardrail's Vendor Enablement lane
ENABLEMENT_ALLOWLIST=         # optional path to a file of approved vendor domains / GitHub orgs (one per line).
                              # EMPTY (default) = NO allowlist: any qualifying vendor source is allowed (broad).
                              # Set a path to pin to listed vendors AND have the gate enforce membership.
                              # Format: see assets/enablement-allowlist.example
                              # Governs in-repo vendor fences only; advisory/discovery answers are never gated.

